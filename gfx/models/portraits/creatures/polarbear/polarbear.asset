pdxmesh = {
	name = "polarbear_mesh"
	file = "polarbear.mesh"
	scale = 1

	blend_shape = { id = "polarbear_gaunt" type = "polarbear_gaunt.mesh" }
	blend_shape = { id = "polarbear_muscular" type = "polarbear_muscular.mesh" }

	animation = { id = "body_idle_1" type = "polarbear_idle_sit.anim" }
	animation = { id = "body_bind_pose" type = "polarbear_bind_pose.anim" }
	animation = { id = "body_emotion_laugh_1" type = "polarbear_emotion_laugh.anim" }

	meshsettings = {
		name = "polarbear"
		index = 0
		texture_diffuse = "polarbear_diffuse.dds"
		texture_normal = "polarbear_normal.dds"
		texture_specular = "polarbear_properties.dds"
		texture = { file = "polarbear_mask.dds" index = 3 }
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

entity = {
	name = "polarbear_entity"
	pdxmesh = "polarbear_mesh"
	
    game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	 }
	 
	get_state_from_parent = yes

	attribute = { name = "bs_body_gaunt_1" blend_shape = "polarbear_gaunt" }
	attribute = { name = "bs_body_fat_1" blend_shape = "polarbear_muscular" }

	default_state = "none"

	state = {	name = "none"															animation = "body_idle_1" }
	state = {	name = "idle_entry"														animation = "body_idle_1" chance = 10 looping = no  next_state = "idle" }
	state = {	name = "idle"															animation = "body_idle_1" chance = 10 looping = no next_state = "idle" }

	state = {	name = "bind_pose"														animation = "body_bind_pose" looping = no next_state = "bind_pose" }

	state = {	name = "emotion_laugh_entry"											animation = "body_emotion_laugh_1" next_state = "emotion_laugh" }
	state = {	name = "emotion_laugh"													animation = "body_emotion_laugh_1" next_state = "emotion_laugh" }
}
